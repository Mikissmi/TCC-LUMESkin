# Copie este arquivo para ".env" (na raiz do projeto) e preencha os valores.
# O arquivo .env NAO vai para o Git.

# Chave secreta do Django. Em producao use um valor longo e aleatorio.
# SECRET_KEY=troque-por-uma-chave-secreta

# True para desenvolvimento; use False em producao.
DEBUG=True

# Chave da API YouCam (analise de pele por IA). Sem ela o scanner nao funciona.
# YOUCAM_API_KEY=

# Login do painel /administradores/ (usado na mesma tela de login).
ADMIN_LOGIN_EMAIL=admin@lumeskin.com
ADMIN_LOGIN_SENHA=troque-esta-senha

# Banco de dados. Sem nada abaixo o projeto usa SQLite local (db.sqlite3).
# PostgreSQL (uma opcao ou a outra):
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
